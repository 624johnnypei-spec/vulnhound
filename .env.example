# ---- Daytona (title sponsor) ---- app.daytona.io -> settings -> API key
DAYTONA_API_KEY=

# ---- Neo4j (sponsor) ---- AuraDB Free: creds shown ONCE at instance creation
NEO4J_URI=neo4j+s://xxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Nosana (sponsor) ---- ask the Nosana rep for credits + deployed endpoint
# Deployed model exposes an OpenAI-compatible base URL.
NOSANA_BASE_URL=
NOSANA_API_KEY=
NOSANA_MODEL=

# ---- Fallback LLM so you are never blocked on Nosana ----
OPENAI_API_KEY=
